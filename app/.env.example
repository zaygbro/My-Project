# Copy this file to .env.local and fill in real values.
# See README.md for where each one comes from.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the browser. Used by the Stripe webhook
# to write subscription data, bypassing Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (Developers → API keys) ---
STRIPE_SECRET_KEY=
# Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=

# --- Stripe Price IDs (Product catalog → each price's ID, starts with "price_") ---
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_STUDIO_MONTHLY=
STRIPE_PRICE_STUDIO_ANNUAL=

# --- Anthropic (console.anthropic.com -> API Keys) ---
# Powers "Generate with AI" on a site's sections. Without this set, that
# button stays visibly disabled rather than pretending to work.
ANTHROPIC_API_KEY=

# --- App ---
# Used to build Stripe redirect URLs. http://localhost:3000 in dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
